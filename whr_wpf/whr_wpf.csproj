    <UseWPF>true</UseWPF>
    <Version>0.01</Version>
    <Company />
    <Copyright>Copyright (c) 2020 MarEnger.</Copyright>
    <Description>鉄道経営シミュレーションゲームです。</Description>
    <AssemblyName>世界鉄道網</AssemblyName>
    <Product>世界鉄道網 (.NET WPF版)</Product>
